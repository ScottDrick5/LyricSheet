{
  "name": "lyric-sheet-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Lyric Sheet desktop prototype",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac dir --universal"
  },
  "build": {
    "appId": "com.lyricsheet.prototype.desktop",
    "productName": "Lyric Sheet",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.music",
      "identity": null,
      "target": [
        "dir"
      ]
    }
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  }
}
