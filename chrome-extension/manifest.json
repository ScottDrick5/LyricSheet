{
  "manifest_version": 3,
  "name": "Audio Grabber",
  "version": "1.3.0",
  "description": "Record the audio playing in any tab (plus your mic, if you like) and save it straight to MP3 or WAV.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "tabCapture",
    "offscreen",
    "downloads",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Audio Grabber",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-recording": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Start / stop recording the current tab"
    }
  }
}
